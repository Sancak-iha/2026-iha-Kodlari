{
  "name": "sancak-yer-istasyonu",
  "productName": "Sancak Yer Istasyonu",
  "version": "1.0.0",
  "description": "2026 Sancak İHA Takımı yer istasyonu: canlı kamera, telemetri, hedef koordinatı",
  "main": "main.js",
  "author": "Sancak İHA Takımı Yazılım Ekibi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "chart.js": "4.4.1"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tr.sancak.yeristasyonu",
    "productName": "Sancak Yer Istasyonu",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}